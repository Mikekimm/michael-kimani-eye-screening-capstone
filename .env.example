# The only environment template in this repository. Placeholders only; never put real values here.
# Copy to .env (or run: .venv\Scripts\python scripts\init_env.py) and never commit .env.
# Read by the API (backend/app/core/config.py), scripts/seed.py, scripts/create_admin.py and docker compose.
# Lines starting with # are optional: the value shown is the default the app uses when the line is absent.

# Database: SQLite by default; PostgreSQL is a config switch, e.g.
# DATABASE_URL=postgresql+psycopg://screening:screening@localhost:5432/screening
DATABASE_URL=sqlite:///data/app.db

# At least 32 random characters. The API will not start with this placeholder.
JWT_SECRET=change-me-run-scripts-init_env-py
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Day boundary for "screened today" and per-day counts (IANA time zone name)
# TIME_ZONE=Africa/Kigali

# Where uploaded photos are stored. Default: data/uploads under the repo root (docker compose sets /app/data/uploads).
# Use an absolute path if you change it.
# UPLOAD_DIR=

# Demo accounts created by scripts/seed.py (synthetic data only)
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=change-me
SEED_SPECIALIST_EMAIL=specialist@example.org
SEED_SPECIALIST_PASSWORD=change-me
SEED_HEALTH_WORKER_EMAIL=nurse@example.org
SEED_HEALTH_WORKER_PASSWORD=change-me

# Optional personal administrator (scripts/create_admin.py). Fill in only in your local .env, never here.
PERSONAL_ADMIN_EMAIL=
PERSONAL_ADMIN_PASSWORD=

# Emails (password reset, sign-up and approval notices). Without SMTP_HOST nothing is sent: each email is
# saved in data/outbox/ and printed in the backend console.
# APP_BASE_URL=http://localhost:5173
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER=Retinal Screening <no-reply@example.org>
# SMTP_STARTTLS=true

# Hosted deployment only: the PWA's host name (added to CORS and used in email links)
# FRONTEND_HOST=retina-screening.onrender.com

# docker compose only: password of the PostgreSQL container
# POSTGRES_PASSWORD=screening-local-only
