digraph er {
  rankdir=LR; fontname="Helvetica"; node [fontname="Helvetica", fontsize=10, shape=plaintext]; edge [fontname="Helvetica", fontsize=10, color="#4A5A57", arrowhead=crow, arrowtail=tee, dir=both];
  screenings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F4F4F0"><TR><TD BGCOLOR="#2E7D5B"><FONT COLOR="white"><B>screenings</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT"><B>id</B> (PK, UUID)</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR><TR><TD ALIGN="LEFT">patient_ref (pseudonymous code)</TD></TR>
<TR><TD ALIGN="LEFT"><B>laterality</B> (left | right | unknown)</TD></TR><TR><TD ALIGN="LEFT">image_sha256, image_path</TD></TR>
<TR><TD ALIGN="LEFT"><B>model_version</B>, classifier_name</TD></TR><TR><TD ALIGN="LEFT">threshold, probability</TD></TR>
<TR><TD ALIGN="LEFT">dr_detected, needs_review</TD></TR><TR><TD ALIGN="LEFT">quality_json, created_by</TD></TR>
<TR><TD ALIGN="LEFT">sync_status (pending | synced | failed)</TD></TR><TR><TD ALIGN="LEFT">sync_attempts, last_sync_error, synced_at</TD></TR></TABLE>>];
  reviews [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F4F4F0"><TR><TD BGCOLOR="#C97A2B"><FONT COLOR="white"><B>reviews</B> (append-only history)</FONT></TD></TR>
<TR><TD ALIGN="LEFT"><B>id</B> (PK, auto)</TD></TR><TR><TD ALIGN="LEFT">screening_id (FK)</TD></TR><TR><TD ALIGN="LEFT">reviewer (from the access token)</TD></TR>
<TR><TD ALIGN="LEFT">decision (approve | override_dr_present |</TD></TR><TR><TD ALIGN="LEFT">&nbsp;&nbsp;override_no_dr | ungradable)</TD></TR>
<TR><TD ALIGN="LEFT">notes, reviewed_at</TD></TR><TR><TD ALIGN="LEFT">remote_id (UNIQUE; makes pull idempotent)</TD></TR></TABLE>>];
  meta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#F4F4F0"><TR><TD BGCOLOR="#6B7876"><FONT COLOR="white"><B>meta</B></FONT></TD></TR><TR><TD ALIGN="LEFT">key (PK), value</TD></TR><TR><TD ALIGN="LEFT">e.g. review_cursor</TD></TR></TABLE>>];
  screenings -> reviews [label="1 screening : 0..* reviews", arrowhead=crowodot];
}
