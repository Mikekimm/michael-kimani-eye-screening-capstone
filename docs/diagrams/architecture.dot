digraph arch {
  rankdir=LR; fontname="Helvetica"; node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#F4F4F0", color="#6B7876"]; edge [fontname="Helvetica", fontsize=10, color="#4A5A57"];
  compound=true; newrank=true;
  subgraph cluster_clinic { label="Clinic device (works with NO internet)"; style="rounded,filled"; fillcolor="#E8F1EC"; color="#2E7D5B"; fontsize=12;
    ui [label="Clinic app\n(Streamlit: app.py)"];
    wf [label="ScreeningWorkflow"];
    svc [label="ScreeningService\npreprocess + quality check\n+ threshold + uncertainty"];
    clf [label="Classifier interface\nKeras .h5 | TFLite .tflite"];
    db [label="Local store\nSQLite + image files\n(image, eye, model version,\nscore, review history)", shape=cylinder, fillcolor="#FFFFFF"];
    sync [label="SyncService\npush pending, pull reviews\n(idempotent, stops when offline)"];
    ui -> wf -> svc -> clf; wf -> db [label="save first"]; ui -> sync; sync -> db [dir=both]; }
  subgraph cluster_cloud { label="Cloud backend (only needed to sync and review)"; style="rounded,filled"; fillcolor="#FBF0E4"; color="#C97A2B"; fontsize=12;
    auth [label="Token authentication\nroles: clinician | specialist | admin"];
    api [label="REST API (src/server.py)\nPOST /api/screenings\nPOST .../reviews  GET /api/reviews"];
    sdb [label="Server store\nSQLite + image files", shape=cylinder, fillcolor="#FFFFFF"];
    portal [label="Specialist portal\n(Streamlit: specialist_app.py)"];
    auth -> api -> sdb; portal -> auth [label="specialist token"]; }
  sync -> auth [label="HTTP + Bearer token (when online)\nTLS via reverse proxy in production", color="#C97A2B", fontcolor="#C97A2B", style=bold];
  api -> sync [label="specialist reviews\n(pulled by cursor)", style=dashed, color="#C97A2B", fontcolor="#C97A2B", constraint=false];
}
