flowchart LR
  HW(["Health worker"])
  SP(["Specialist"])
  AD(["Admin"])

  subgraph HWU["Health worker use cases"]
    direction TB
    UC2["Register patient (clinic code)"]
    UC3["Capture or upload fundus photo<br/>(left or right eye)"]
    UC4["Run screening<br/>(quality gate, fundus check, every available model)"]
    UC5["View result per condition<br/>(estimated band, action, model version)"]
    UC6["Ask a specialist (with a question);<br/>nothing is sent automatically"]
    UC7["Queue offline, sync later"]
    UC8["View patient history and decisions;<br/>remove a screening with a reason"]
    UC3 -. include .-> UC4 -. include .-> UC5
  end

  subgraph SPU["Specialist use cases"]
    direction TB
    UC9["Review cases sent by health workers"]
    UC10["Approve / override with reason /<br/>request retake / comment"]
    UC9 -. include .-> UC10
  end

  subgraph ADU["Admin use cases"]
    direction TB
    UC11["Approve or reject sign-up requests;<br/>manage users and roles"]
    UC12["View aggregate analytics"]
  end

  subgraph ALL["Every role"]
    direction TB
    UC1["Request access (health worker or specialist) /<br/>sign in"]
    UC13["View model information and limits"]
  end

  HW --> HWU
  SP --> SPU
  AD --> ADU
  HW & SP & AD --> ALL
