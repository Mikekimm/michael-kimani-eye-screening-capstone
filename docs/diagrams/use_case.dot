digraph uc {
  rankdir=LR; fontname="Helvetica"; node [fontname="Helvetica", fontsize=11]; edge [color="#4A5A57"];
  node [shape=box, style="rounded,filled", fillcolor="#E8F1EC", color="#2E7D5B"]; hw [label="Health worker\n(clinic nurse / clinical officer)"];
  node [fillcolor="#FBF0E4", color="#C97A2B"]; sp [label="Specialist\n(ophthalmologist)"]; ad [label="Administrator"];
  subgraph cluster_off { label="Offline (no internet needed)"; style="rounded,dashed"; color="#2E7D5B"; node [shape=ellipse, style=filled, fillcolor="#FFFFFF", color="#6B7876"];
    u1 [label="Enter patient code\n+ choose eye"]; u2 [label="Upload fundus photo"]; u3 [label="Screen image\n(quality check + model)"]; u4 [label="View result and advice"]; u5 [label="Save record locally"]; u2 -> u3 [style=dashed, label="«include»"]; u3 -> u5 [style=dashed, label="«include»"]; }
  subgraph cluster_on { label="Online (when connected)"; style="rounded,dashed"; color="#C97A2B"; node [shape=ellipse, style=filled, fillcolor="#FFFFFF", color="#6B7876"];
    s1 [label="Sync records and\npull specialist decisions"]; s2 [label="Review flagged /\nborderline case"]; s3 [label="Approve or override\n(history kept)"]; s4 [label="View statistics"]; s2 -> s3 [style=dashed, label="«include»"]; }
  hw -> u1; hw -> u2; hw -> u4; hw -> s1; sp -> s2; ad -> s4; sp -> s4;
}
